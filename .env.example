# Copy this file to ".env" and fill in your key.
#
# Option 1 — OpenAI (paid):
#   Get a key at: https://platform.openai.com/api-keys
#
# Option 2 — GitHub Models (free for GitHub users):
#   1. Create a Personal Access Token at: https://github.com/settings/personal-access-tokens/new
#      (fine-grained token with "Models: Read-only" permission)
#   2. Set OPENAI_API_KEY to that token
#   3. Set OPENAI_BASE_URL as shown below
#   See available models: https://github.com/marketplace/models
OPENAI_API_KEY=your-api-key-here
OPENAI_BASE_URL=https://models.github.ai/inference
OPENAI_MODEL=openai/gpt-4o-mini
